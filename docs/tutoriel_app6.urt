%b%Tutoriel 6 — Exemple complet : une app avec menu principal et sous-menus%\b%

%g%Objectif:%\g% Fournir un exemple concret et complet : code source, Makefile minimal, et explications étape par étape.

%pp%1) Arborescence de l'exemple%\pp%

%c%/apps/mon_exemple/
  Makefile
  app.h
  app.cpp
  main_menu_controller.h
  main_menu_controller.cpp
  resources/mon_exemple_icon.*%\c%

%pp%2) `main_menu_controller.h` (squelette)%\pp%

%c%#ifndef MAIN_MENU_CONTROLLER_H
#define MAIN_MENU_CONTROLLER_H

#include <escher.h>
#include <vector>

class MainMenuController : public ViewController, public TableViewDataSource, public TableViewDelegate {
public:
  MainMenuController(Responder * parent);
  View * view() override;
  int numberOfRows() const override;
  HighlightCell * reusableCell(int index) override;
  int reusableCellCount() const override;
  void willDisplayCellForIndex(HighlightCell * cell, int index) override;
  bool handleEvent(Ion::Events::Event event) override;
private:
  MessageTableCell<> m_cells[6];
  TableView m_tableView;
};

#endif
%\c%

%pp%3) `main_menu_controller.cpp` (simplifié)%\pp%

%c%#include "main_menu_controller.h"
#include "sub_menu_controller.h"

MainMenuController::MainMenuController(Responder * parent) :
  ViewController(parent),
  m_tableView(this, this, this)
{
}

View * MainMenuController::view() { return &m_tableView; }

int MainMenuController::numberOfRows() const { return 3; }
int MainMenuController::reusableCellCount() const { return 3; }
HighlightCell * MainMenuController::reusableCell(int index) { return &m_cells[index]; }

void MainMenuController::willDisplayCellForIndex(HighlightCell * cell, int index) {
  MessageTableCell<> * myCell = static_cast<MessageTableCell<> *>(cell);
  switch(index) {
    case 0: myCell->labelView()->setText("Lire un fichier"); break;
    case 1: myCell->labelView()->setText("Paramètres"); break;
    case 2: myCell->labelView()->setText("À propos"); break;
  }
}

bool MainMenuController::handleEvent(Ion::Events::Event event) {
  if (event == Ion::Events::OK) {
    int row = m_tableView.selectedRow();
    if (row == 0) {
      // ouvrir reader
      return true;
    }
    if (row == 1) {
      // push parameters
      return true;
    }
    if (row == 2) {
      // afficher about
      return true;
    }
  }
  return false;
}
%\c%

%pp%4) `app.h` et `app.cpp` — raccrochage%\pp%

%c%// app.h
class App : public ::App {
public:
  class Descriptor : public ::App::Descriptor { /* ... */ };
  class Snapshot : public ::App::Snapshot { /* ... */ };
private:
  App(Snapshot * snapshot);
  MainMenuController m_mainMenuController;
  StackViewController m_stackViewController;
};

// app.cpp
App::App(Snapshot * snapshot) : ::App(snapshot, &m_stackViewController),
  m_mainMenuController(&m_stackViewController),
  m_stackViewController(&m_modalController, &m_mainMenuController)
{
}
%\c%

%g%5) Tests et validation%\g% :
- Compiler l'app avec le Makefile global
- Lancer sur émulateur (si disponible) ou device
- Vérifier navigation, memory/stack et comportements des callbacks

%r%Remarques finales%\r% : Ce dossier d'exemple peut être copié et adapté. N'hésitez pas à comparer avec `apps/reader` et autres apps pour suivre les patterns utilisés dans Upsilon.
